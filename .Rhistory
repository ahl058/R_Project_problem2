library(dplyr)
adip_data <- read.table('adipodatav8.tsv',sep='\t',stringsAsFactors = TRUE, header=TRUE, row.names = FALSE)
row.names(adip_data) <- NULL
adip_data
adip_clean <- data.frame('m.id'=adip_data$m.id,'mouse'=adip_data$mouse,'image'=adip_data$image,'pixel2'=adip_data$pixel2)
# With the package dplyr we're going to modify that data frame we've created.
adip_clean <- adip_clean %>%
# This will group the variables hierarchically so that later we can calculate the mean sorting by this order.
group_by(m.id, mouse, image) %>%
# summarise let us to create a new column with, in this case, the mean, by the agrupation we did before.
summarise(mean_img = mean(pixel2))
print(adip_clean, n=nrow(adip))
